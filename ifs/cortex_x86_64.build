# ==============================================================================
# QNX-CortexCage: Bootable Image File System (IFS) Buildfile for x86_64
# Target Architecture: x86_64 (Multiboot / QEMU / Bare-Metal PC)
# Target OS: QNX Neutrino RTOS SDP 8.0
# ==============================================================================

[image=0x1400000]
[virtual=x86_64,multiboot +compress] boot = {
    # Microkernel Startup for x86_64 with serial debug console COM1 (0x3f8, 115200)
    startup-x86 -v -D8250..115200 -zz
    PATH=/proc/boot
    LD_LIBRARY_PATH=/proc/boot
    procnto-smp-instr -v
}

[+script] startup-script = {
    display_msg "=================================================================="
    display_msg "  QNX-CORTEXCAGE: Microkernel-Enforced Simplex Cage (x86_64)      "
    display_msg "  Target: QNX Neutrino RTOS SDP 8.0 Hard Real-Time Simplex Cage   "
    display_msg "=================================================================="

    # Configure core dynamic linker symlink
    procmgr_symlink /proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2

    # Start 8250 serial driver for COM1
    devc-ser8250 -e -F 0x3f8,4 &
    reopen /dev/ser1

    display_msg "[CORTEX_INIT] Launching Simplex Safety Resource Manager (/dev/cortex_gate)..."
    cortex_gate_resmgr &

    display_msg "[CORTEX_INIT] Launching Hard Real-Time 1kHz Safety Loop (Pri 63 SCHED_FIFO)..."
    safety_actuator_loop &

    display_msg "[CORTEX_INIT] Launching Self-Healing Watchdog Supervisor (Pri 62)..."
    watchdog_supervisor &

    display_msg "[CORTEX_INIT] Launching Live Telemetry Bridge JSON Streamer..."
    telemetry_bridge
}

[type=link] /usr/lib/ldqnx-64.so.2 = /proc/boot/ldqnx-64.so.2

# Core QNX Neutrino 8.0 Shared Libraries
libc.so
libgcc_s.so.1
ldqnx-64.so.2
libsecpol.so.1
libm.so

# Serial Driver
devc-ser8250

# QNX-CortexCage Native Binaries
cortex_gate_resmgr   = bin/x86_64/cortex_gate_resmgr
ai_neural_planner    = bin/x86_64/ai_neural_planner
safety_actuator_loop = bin/x86_64/safety_actuator_loop
watchdog_supervisor  = bin/x86_64/watchdog_supervisor
telemetry_bridge     = bin/x86_64/telemetry_bridge
